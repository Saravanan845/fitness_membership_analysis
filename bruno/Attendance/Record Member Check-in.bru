meta {
  name: Record Member Check-in
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/attendance
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "memberId": "M1001",
    "activityType": "HIIT Class",
    "durationMinutes": 60,
    "notes": "Morning metabolic conditioning session"
  }
}
